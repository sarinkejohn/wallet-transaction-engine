				"body": {"mode": "raw","raw": "{\n    \"customerId\": 1,\n    \"transactionType\": \"TRANSFER\",\n    \"amount\": 50000,\n    \"currency\": \"TZS\",\n    \"channel\": \"MOBILE_APP\",\n    \"receiverMobile\": \"255712345678\",\n    \"idempotencyKey\": \"TXN-20260521-0001\"\n}"}
