				"body": {"mode": "raw","raw": "{\n    \"channel\": \"MOBILE_APP\",\n    \"minAmount\": 0.0,\n    \"maxAmount\": 100000.00,\n    \"chargeType\": \"FIXED\",\n    \"chargeValue\": 500.00\n}"}
